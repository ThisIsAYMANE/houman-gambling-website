{
  "name": "bc-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:admin": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "start:admin": "next start -p 3001",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "test": "tsx tests/run-tests.ts",
    "test:wallet": "tsx tests/test-wallet-manual.ts",
    "test:api": "tsx tests/test-api-manual.ts",
    "test:phase1": "tsx tests/test-wallet-manual.ts && tsx tests/test-api-manual.ts",
    "test:phase2:deposit": "tsx tests/test-phase2-deposit.ts",
    "test:phase2:payment": "tsx tests/test-phase2-payment.ts",
    "test:phase2:full": "tsx tests/test-phase2-full.ts",
    "test:phase2:complete": "tsx tests/test-phase2-complete.ts",
    "test:phase2": "tsx tests/test-phase2-deposit.ts",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "test:all": "npm run test:unit && npm run test:phase2",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
